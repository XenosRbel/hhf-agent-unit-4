MODEL=openai/gpt-4o-mini
# MODEL=anthropic/claude-3-5-sonnet-20241022
# MODEL=openrouter/qwen/qwen-2.5-72b-instruct
# --- свой LiteLLM router (OpenAI-compatible proxy) ---
# LITELLM_API_BASE=http://localhost:4000
# LITELLM_API_KEY=sk-your-router-key
# либо стандартно:
# OPENAI_API_BASE=http://localhost:4000/v1
# OPENAI_API_KEY=sk-your-router-key
# STT: имя STТ-модели на твоём роутере, или пусто = локальный faster-whisper
# TRANSCRIBE_MODEL=openai/whisper-large-v3
# WHISPER_LOCAL=tiny
GAIA_API_BASE=https://agents-course-unit4-scoring.hf.space
# HF_TOKEN нужен для скачивания файлов GAIA (gated dataset) через fallback
HF_TOKEN=
HF_USERNAME=
AGENT_CODE_LINK=local-run
MAX_STEPS=12
